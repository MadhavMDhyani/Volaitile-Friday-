# ==============================================================================
# Volaitile Friday - Backend Environment Configuration Example
# Copy this file to .env and fill in the appropriate values for your environment.
# Never commit real secrets or production credentials to version control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Client URL (Allowed CORS origins, comma-separated in production)
CLIENT_URL=http://localhost:5173

# Reverse Proxy Trust (1 for single reverse proxy like Nginx/Cloudflare, 0 for direct)
TRUST_PROXY=1

# MongoDB Connection String (Required)
MONGODB_URI=mongodb://localhost:27017/volaitile_friday

# JWT Authentication (JWT_SECRET must be at least 32 characters long)
JWT_SECRET=replace_with_a_secure_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# Redis Configuration (Optional: falls back to in-memory TTL cache if offline)
# Use REDIS_URL for managed Redis (e.g. Upstash, AWS ElastiCache, rediss:// for TLS)
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Google Gemini AI Integration (Optional: falls back to offline engine if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
