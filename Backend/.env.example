# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/volaitile_friday

# JWT Authentication (JWT_SECRET must be at least 32 characters long)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# Redis Configuration (Optional: falls back to in-memory TTL cache if offline)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional AI Integration (Google Gemini API)
GEMINI_API_KEY=

